{
  "manifest_version": 3,
  "name": "Vorpet",
  "version": "0.0.1",
  "description": "A useful virtual pet",
  "permissions": ["contextMenus", "storage"],
  "host_permissions": ["http://localhost:3000/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "index.html"
  }
}
